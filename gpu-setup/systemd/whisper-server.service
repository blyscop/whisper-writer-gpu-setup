[Unit]
Description=whisper.cpp server (Vulkan) pour WhisperWriter
After=graphical-session.target

[Service]
ExecStart=/usr/bin/whisper-server \
  -m %h/.local/share/whisper-cpp/ggml-large-v3-turbo-q5_0.bin \
  -l fr \
  --host 127.0.0.1 --port 8089 \
  --request-path /v1 --inference-path /audio/transcriptions \
  -ml 100000 \
  --vad -vm %h/.local/share/whisper-cpp/ggml-silero-v5.1.2.bin
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
